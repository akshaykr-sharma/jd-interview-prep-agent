# Copy this file to .env and edit. .env is git-ignored.

# --- Local model (Ollama) ---------------------------------------------
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2

# --- Inputs / outputs -----------------------------------------------------
# Only used by `langgraph dev`; the CLI takes --jd and --resume instead.
PREPKIT_JD_PATH=samples/jd_ml_engineer.md
# Optional: your resume exported to .md or .txt
PREPKIT_RESUME_PATH=
# Where kits are written (default ./output/kits)
PREPKIT_OUTPUT_DIR=

# --- LangSmith (free Developer plan, never add a card) -------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prepkit
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
